# Solo ejecución nativa opcional. La ruta recomendada es Docker Compose desde raíz.
DB_USER=ute_dual_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ute_dual_c01
DB_MIN_SIZE=1
DB_MAX_SIZE=5
DB_TIMEOUT_CONN=10
# Generar un secreto aleatorio de al menos 32 caracteres. Nunca versionar .env.
SECRET_KEY=
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Opcionales para el adaptador Drive heredado; no necesarios para login/health.
GMAIL_CREDENTIALS_PATH=
DRIVE_FOLDER_DUAL=
